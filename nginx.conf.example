# ===== Nginx 反向代理配置示例 =====
# 将此文件放到 /etc/nginx/conf.d/poker.conf （或 sites-available 并软链到 sites-enabled）
# 将 your-domain.com 替换为你的实际域名
# 放置后执行: nginx -t && systemctl reload nginx

# HTTP 配置（开发/测试用，生产建议用下方 HTTPS 配置）
server {
    listen 80;
    server_name your-domain.com;  # 改成你的域名或服务器公网IP

    # WebSocket 升级支持（Socket.IO 必须）
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 长连接超时（WebSocket 需要）
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}

# ===== HTTPS 配置（生产推荐，需先申请证书）=====
# 用 Certbot 申请免费证书: certbot --nginx -d your-domain.com
